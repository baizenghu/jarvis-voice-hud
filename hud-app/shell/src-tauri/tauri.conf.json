{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis HUD",
  "version": "0.0.1",
  "identifier": "com.jarvis.voicehud",
  "build": {
    "frontendDist": "../../hud/dist",
    "beforeDevCommand": "npm --prefix ../hud run build",
    "beforeBuildCommand": "npm --prefix ../hud run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"]
  }
}
